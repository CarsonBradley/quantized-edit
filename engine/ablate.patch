diff -ruN a/engine/src/inkling2/metal/ink_ablate_dirs.h b/engine/src/inkling2/metal/ink_ablate_dirs.h
--- a/engine/src/inkling2/metal/ink_ablate_dirs.h	1969-12-31 19:00:00
+++ b/engine/src/inkling2/metal/ink_ablate_dirs.h	2026-11-22 12:56:57
@@ -0,0 +1,77 @@
+// ink_ablate_dirs.h - local patch (quantized-edit): strict loader for the --ablate direction file (DIRS.bin).
+//
+// DIRS.bin layout (little-endian), written by engine/make_dirs.py in the quantized-edit repository:
+//   off  0  char[8]   magic  "INKABL\0\1"
+//   off  8  u32       version          = 1
+//   off 12  u32       n_layers         = model physical layers (24)
+//   off 16  u32       hidden           = model hidden size (2304)
+//   off 20  u32       n_vec            = n_layers + 1
+//   off 24  u32       flags            = 1  (bit 0: row n_layers is the token-embedding direction)
+//   off 28  u32       header_bytes     = 64
+//   off 32  u8[32]    sha256 of the source LoRA GGUF (provenance only)
+//   off 64  f32[n_vec][hidden]  unit vectors: rows 0..n_layers-1 = r_L (attn wo_ud + routed experts' down),
+//                               row n_layers = r_emb
+// File size must be exactly 64 + n_vec * hidden * 4.
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace ink_metal {
+
+struct AblateDirs {
+    std::vector<float> dirs;   // [n_layers + 1, hidden]
+    uint8_t src_sha256[32]{};
+};
+
+inline bool load_ablate_dirs(const std::string& path, int n_layers, int hidden, AblateDirs& out, std::string& err) {
+    static const uint8_t kMagic[8] = {'I', 'N', 'K', 'A', 'B', 'L', 0x00, 0x01};
+    FILE* f = std::fopen(path.c_str(), "rb");
+    if (!f) { err = "ablate: cannot open " + path; return false; }
+    std::vector<uint8_t> buf;
+    uint8_t tmp[1 << 16];
+    size_t n;
+    while ((n = std::fread(tmp, 1, sizeof(tmp), f)) > 0) {
+        buf.insert(buf.end(), tmp, tmp + n);
+        if (buf.size() > (64u << 20)) { std::fclose(f); err = "ablate: file too large"; return false; }
+    }
+    std::fclose(f);
+    if (buf.size() < 64) { err = "ablate: file shorter than its 64-byte header"; return false; }
+    if (std::memcmp(buf.data(), kMagic, 8) != 0) { err = "ablate: bad magic (expected INKABL\\0\\1)"; return false; }
+    uint32_t h[6];
+    std::memcpy(h, buf.data() + 8, sizeof(h));
+    const uint32_t version = h[0], nl = h[1], hd = h[2], nv = h[3], flags = h[4], hbytes = h[5];
+    if (version != 1) { err = "ablate: unsupported version " + std::to_string(version); return false; }
+    if (hbytes != 64) { err = "ablate: header_bytes != 64"; return false; }
+    if ((int)nl != n_layers) { err = "ablate: n_layers " + std::to_string(nl) + " != model " + std::to_string(n_layers); return false; }
+    if ((int)hd != hidden) { err = "ablate: hidden " + std::to_string(hd) + " != model " + std::to_string(hidden); return false; }
+    if (nv != nl + 1) { err = "ablate: n_vec must be n_layers + 1"; return false; }
+    if (flags != 1u) { err = "ablate: flags must be 1 (embedding row present)"; return false; }
+    const size_t want = 64 + (size_t)nv * hd * sizeof(float);
+    if (buf.size() != want) {
+        err = "ablate: file size " + std::to_string(buf.size()) + " != expected " + std::to_string(want);
+        return false;
+    }
+    std::memcpy(out.src_sha256, buf.data() + 32, 32);
+    out.dirs.resize((size_t)nv * hd);
+    std::memcpy(out.dirs.data(), buf.data() + 64, out.dirs.size() * sizeof(float));
+    for (uint32_t v = 0; v < nv; ++v) {
+        double ss = 0.0;
+        for (uint32_t i = 0; i < hd; ++i) {
+            const float x = out.dirs[(size_t)v * hd + i];
+            if (!std::isfinite(x)) { err = "ablate: non-finite value in row " + std::to_string(v); return false; }
+            ss += (double)x * x;
+        }
+        if (std::fabs(std::sqrt(ss) - 1.0) > 1e-4) {
+            err = "ablate: row " + std::to_string(v) + " is not a unit vector (norm " + std::to_string(std::sqrt(ss)) + ")";
+            return false;
+        }
+    }
+    return true;
+}
+
+}  // namespace ink_metal
diff -ruN a/engine/src/inkling2/metal/ink_metal_ablate.metal b/engine/src/inkling2/metal/ink_metal_ablate.metal
--- a/engine/src/inkling2/metal/ink_metal_ablate.metal	1969-12-31 19:00:00
+++ b/engine/src/inkling2/metal/ink_metal_ablate.metal	2026-11-22 12:55:36
@@ -0,0 +1,162 @@
+// ink_metal_ablate.metal - OPT-IN runtime directional ablation (--ablate DIRS.bin) for Inkling-2-Mini.
+// Local patch (W3), not part of upstream Strata. Compiled into its own MTLLibrary ONLY when --ablate is
+// given, so the stock libraries (codecs/ops/dspark/vision/mpp) and their dispatch graph are untouched
+// when the flag is absent.
+//
+// The AtomicChat uncensoring LoRA is, for every residual writer W (attn wo_ud, all routed experts'
+// down projections, the token embedding), exactly W' = (I - r r^T) W with one unit vector r per layer
+// (r_emb for the embedding). Applying it to the writer's OUTPUT is therefore exact:
+//     y' = y - S * r (r . y)        (S = --ablate-scale, 1.0 = the published edit)
+// and for the MoE it commutes with the routing-weighted sum over experts.
+// All buffers touched here are FP32 activations.
+#include <metal_stdlib>
+using namespace metal;
+
+#define ABL_D 2304
+#define ABL_RMS_EPS 1e-6f
+
+static inline float abl_bf16_to_f32(ushort b) { return as_type<float>(uint(b) << 16); }
+
+// Same reduction as ops_tg_sum in ink_metal_ops.metal (simd_sum + 8-slot threadgroup sum).
+static inline float abl_tg_sum(float v, threadgroup float* sh, uint tid, uint nthr) {
+    v = simd_sum(v);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if ((tid & 31u) == 0u) sh[tid >> 5] = v;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float r = 0.0f;
+    const uint nw = (nthr + 31u) >> 5;
+    for (uint i = 0; i < nw; ++i) r += sh[i];
+    return r;
+}
+
+// In-place projection of M rows of [M, 2304] FP32: y[m] -= S * r (r . y[m]).
+// grid (M, 1, 1), 256 threads. Sites A (b_wo_raw), M1/M2 (b_moe_raw).
+kernel void ink_abl_proj(
+    device float* y               [[buffer(0)]],
+    device const float* r         [[buffer(1)]],
+    constant float& S             [[buffer(2)]],
+    uint m   [[threadgroup_position_in_grid]],
+    uint tid [[thread_index_in_threadgroup]]) {
+    threadgroup float sh[8];
+    device float* row = y + (size_t)m * ABL_D;
+    float v[9];
+    float s = 0.0f;
+    for (uint j = 0; j < 9; ++j) {
+        v[j] = row[tid + 256u * j];
+        s += v[j] * r[tid + 256u * j];
+    }
+    const float c = abl_tg_sum(s, sh, tid, 256) * S;
+    for (uint j = 0; j < 9; ++j) row[tid + 256u * j] = v[j] - c * r[tid + 256u * j];
+}
+
+// Site M3: replaces the reduce half of the fused ink_moe_red8_sconv_add on the decode/multi-slot path.
+// out[m] = proj( sum_{k<8} y_pairs[m*8+k] )  (same k-order summation as ink_moe_reduce8 / red8_sconv_add)
+// grid (M, 1, 1), 256 threads. The sconv + residual add then runs in stock ink_sconv4_attn_res.
+kernel void ink_abl_red8_proj(
+    device const float* y_pairs   [[buffer(0)]],
+    device const float* r         [[buffer(1)]],
+    device float* out             [[buffer(2)]],
+    constant float& S             [[buffer(3)]],
+    uint m   [[threadgroup_position_in_grid]],
+    uint tid [[thread_index_in_threadgroup]]) {
+    threadgroup float sh[8];
+    float v[9];
+    float s = 0.0f;
+    for (uint j = 0; j < 9; ++j) {
+        const uint d = tid + 256u * j;
+        float a = 0.0f;
+        for (int k = 0; k < 8; ++k) a += y_pairs[((size_t)m * 8 + k) * ABL_D + d];
+        v[j] = a;
+        s += a * r[d];
+    }
+    const float c = abl_tg_sum(s, sh, tid, 256) * S;
+    for (uint j = 0; j < 9; ++j) {
+        const uint d = tid + 256u * j;
+        out[(size_t)m * ABL_D + d] = v[j] - c * r[d];
+    }
+}
+
+// Site E: embedding lookup + projection (BEFORE embed_norm, as llama.cpp adds the token_embd LoRA delta
+// to get_rows() output) + embed_norm RMSNorm. Image rows bypass exactly like stock (llama.cpp applies the
+// token_embd LoRA only to token rows). Exact two-pass: RMS is taken over the projected row.
+// Argument layout = stock ink_embed_q8row (buffers 0..6) + r_emb (7) + S (8).
+kernel void ink_abl_embed_q8row(
+    device const uchar* embed_w   [[buffer(0)]],
+    device const float* norm_w    [[buffer(1)]],
+    device const int* tok_ids     [[buffer(2)]],
+    device const uchar* is_img    [[buffer(3)]],
+    device const float* img_emb   [[buffer(4)]],
+    device float* cur_out         [[buffer(5)]],
+    constant int& V_padded        [[buffer(6)]],
+    device const float* r         [[buffer(7)]],
+    constant float& S             [[buffer(8)]],
+    uint m   [[threadgroup_position_in_grid]],
+    uint tid [[thread_index_in_threadgroup]]) {
+    threadgroup float sh[8];
+    if (is_img && is_img[m] != 0) {
+        for (uint d = tid; d < ABL_D; d += 256)
+            cur_out[(size_t)m * ABL_D + d] = img_emb[(size_t)m * ABL_D + d];
+        return;
+    }
+    const int id = tok_ids[m];
+    const float sc = ((device const float*)embed_w)[id];
+    device const char* row = (device const char*)(embed_w + (size_t)V_padded * 4) + (size_t)id * ABL_D;
+    float v[9];
+    float s = 0.0f;
+    for (uint j = 0; j < 9; ++j) {
+        const uint d = tid + 256u * j;
+        v[j] = float(row[d]) * sc;
+        s += v[j] * r[d];
+    }
+    const float c = abl_tg_sum(s, sh, tid, 256) * S;
+    float ss = 0.0f;
+    for (uint j = 0; j < 9; ++j) {
+        v[j] = v[j] - c * r[tid + 256u * j];
+        ss += v[j] * v[j];
+    }
+    const float inv = rsqrt(abl_tg_sum(ss, sh, tid, 256) / float(ABL_D) + ABL_RMS_EPS);
+    for (uint j = 0; j < 9; ++j) {
+        const uint d = tid + 256u * j;
+        cur_out[(size_t)m * ABL_D + d] = v[j] * inv * norm_w[d];
+    }
+}
+
+// Argument layout = stock ink_embed_bf16 (buffers 0..5) + r_emb (6) + S (7).
+kernel void ink_abl_embed_bf16(
+    device const ushort* embed_w  [[buffer(0)]],
+    device const float* norm_w    [[buffer(1)]],
+    device const int* tok_ids     [[buffer(2)]],
+    device const uchar* is_img    [[buffer(3)]],
+    device const float* img_emb   [[buffer(4)]],
+    device float* cur_out         [[buffer(5)]],
+    device const float* r         [[buffer(6)]],
+    constant float& S             [[buffer(7)]],
+    uint m   [[threadgroup_position_in_grid]],
+    uint tid [[thread_index_in_threadgroup]]) {
+    threadgroup float sh[8];
+    if (is_img && is_img[m] != 0) {
+        for (uint d = tid; d < ABL_D; d += 256)
+            cur_out[(size_t)m * ABL_D + d] = img_emb[(size_t)m * ABL_D + d];
+        return;
+    }
+    const int id = tok_ids[m];
+    device const ushort* row = embed_w + (size_t)id * ABL_D;
+    float v[9];
+    float s = 0.0f;
+    for (uint j = 0; j < 9; ++j) {
+        const uint d = tid + 256u * j;
+        v[j] = abl_bf16_to_f32(row[d]);
+        s += v[j] * r[d];
+    }
+    const float c = abl_tg_sum(s, sh, tid, 256) * S;
+    float ss = 0.0f;
+    for (uint j = 0; j < 9; ++j) {
+        v[j] = v[j] - c * r[tid + 256u * j];
+        ss += v[j] * v[j];
+    }
+    const float inv = rsqrt(abl_tg_sum(ss, sh, tid, 256) / float(ABL_D) + ABL_RMS_EPS);
+    for (uint j = 0; j < 9; ++j) {
+        const uint d = tid + 256u * j;
+        cur_out[(size_t)m * ABL_D + d] = v[j] * inv * norm_w[d];
+    }
+}
